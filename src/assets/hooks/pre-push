#!/bin/sh
# baseline — pre-push hook
# Advisory only: recommend pull requests and traceable branch names.
# Pushes are always allowed.

PROTECTED="main master qa develop"
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# --- 1. Recommend pull requests for protected branches ---
for b in $PROTECTED; do
  if [ "$BRANCH" = "$b" ]; then
    echo ""
    echo "  baseline: recommendation: send changes to '$BRANCH' through a pull request."
    echo ""
    echo "  Protected branches: $PROTECTED"
    echo "  Push allowed; this advisory hook never blocks pushes."
    echo ""
    echo "  For traceability, consider starting from a Jira ticket or SDD change:"
    echo "    git checkout -b feat/PROJ-123-description     (with Jira)"
    echo "    git checkout -b feat/sdd-<change-id>-description  (without Jira)"
    echo ""
    echo "  Then open a PR with: /branch-pr"
    echo ""
  fi
done

# --- 2. Recommend a Jira key or SDD id in the branch name ---
if echo "$BRANCH" | grep -qE '[A-Z]+-[0-9]+'; then
  HAS_JIRA="yes"
else
  HAS_JIRA="no"
fi

if echo "$BRANCH" | grep -qiE 'sdd-[a-z0-9-]+'; then
  HAS_SDD="yes"
else
  HAS_SDD="no"
fi

if [ "$HAS_JIRA" = "no" ] && [ "$HAS_SDD" = "no" ]; then
  echo ""
  echo "  baseline: recommendation: link branch '$BRANCH' to a work item when possible."
  echo ""
  echo "  Recommended branch formats:"
  echo "    feat/PROJ-123-description        ← Jira ticket key"
  echo "    feat/sdd-<change-id>-description ← SDD change (no Jira)"
  echo ""
  echo "  Push allowed; rename the branch only if it helps your team's traceability:"
  echo "    git branch -m feat/PROJ-123-description"
  echo ""
fi

# This hook is advisory and must never prevent a push.
exit 0
